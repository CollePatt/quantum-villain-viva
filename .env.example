# Server-side only. Never give a secret a VITE_ prefix: those values are built into the browser code.
OPENAI_API_KEY=paste-your-key-here
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=ash
OPENAI_GRADER_MODEL=gpt-4.1-mini

# Local API server
PORT=8787
HOST=127.0.0.1

# Optional. If either code is set, live voice asks for it. Leave both blank for a public game.
VIVA_ACCESS_CODE=
VIVA_ADMIN_CODE=

# Rate limiting is off locally and on by default on Vercel. Set RATE_LIMIT_ENABLED only to override.
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=20
RATE_LIMIT_ADMIN_MAX=200
RATE_LIMIT_WINDOW_MINUTES=60

ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,https://collepatt.github.io
# Only for a frontend hosted apart from the API, such as GitHub Pages. Leave blank on Vercel.
VITE_API_BASE_URL=

# Scoreboard (optional). Run supabase/leaderboard.sql once, then add these server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional: signs scores so only graded games can be posted. Defaults to the Supabase key.
LEADERBOARD_SECRET=
